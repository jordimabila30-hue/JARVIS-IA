# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé secrète (`sb_secret_...`) ou legacy `service_role` (eyJ...) :
# backend uniquement, ne jamais l'embarquer dans Flutter.
SUPABASE_SERVICE_ROLE_KEY=
# Clé publique (`sb_publishable_...` ou legacy `anon`) : non utilisée par l'API,
# seulement par scripts/smoke_test.py et par l'app Flutter.
SUPABASE_PUBLISHABLE_KEY=
# Secret JWT legacy (HS256). Laisser vide si le projet utilise les clés
# asymétriques (ES256/RS256) : la validation passe alors par le JWKS public.
SUPABASE_JWT_SECRET=

# --- Redis --------------------------------------------------------------------
# Dev (docker compose) :
REDIS_URL=redis://localhost:6379/0
# Prod Upstash (TLS) :
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# --- MIA universel : fournisseur de modèle (app/llm/) -------------------------
# Fournisseur de TOUTES les demandes ordinaires (chat écrit, vocal, WhatsApp,
# propositions, « Reprendre ») : anthropic (Claude). Aucun basculement
# automatique. GroqCloud (« groq », variables OPENAI_* ci-dessous) est
# réservé aux tests autorisés (voir LLM_SELECTION_MANUELLE).
LLM_PROVIDER=anthropic
# Clé privée, backend uniquement (jamais dans Flutter ni dans les journaux).
ANTHROPIC_API_KEY=
# Modèle Claude, à choisir (ex. claude-opus-5-5, claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Effort de raisonnement par défaut : low, medium, high, xhigh, max (vide :
# valeur par défaut du modèle). Ignoré par les modèles qui ne l'acceptent pas.
# Les lots de propositions utilisent LLM_EFFORT_PROPOSITIONS (low).
ANTHROPIC_EFFORT=
# Budget d'entrée des extraits WhatsApp avec Claude (tokens estimés).
ANTHROPIC_COMPREHENSION_BUDGET_TOKENS=20000
# Réflexion interne comptée dans le plafond de sortie : marge ajoutée.
LLM_REFLEXION_MARGE_TOKENS=8000
# LLM_EFFORT_PROPOSITIONS=low

# Choix manuel du fournisseur (en-tête X-Jarvis-Fournisseur, console de test) :
# accepté SEULEMENT si ENVIRONNEMENT n'est pas « production »,
# LLM_SELECTION_MANUELLE=true ET le compte est dans LLM_ADMINS (identifiants
# Supabase, liste JSON). Sinon 403. Jamais d'en-tête depuis Flutter.
ENVIRONNEMENT=production
LLM_SELECTION_MANUELLE=false
LLM_ADMINS=[]

# Abonnements (docs/backend/ABONNEMENTS.md) : true = fournisseur et modèle de
# l'offre du compte (plan_config : Free → groq, Pro → anthropic) ; false =
# LLM_PROVIDER pour tous. Retour arrière : false puis recréer le conteneur.
ABONNEMENTS_ROUTAGE=false

# ODO (outils, docs/backend/ODO.md), INDÉPENDANT de ABONNEMENTS_ROUTAGE.
# false (défaut) = chat inchangé : aucun outil proposé, aucun appel en plus.
# Outils fictifs : tests seulement, jamais chargés en production.
ODO_ACTIF=false
ODO_OUTILS_FICTIFS=false
# Garde-fous techniques par demande (pas des quotas utilisateur)
# ODO_MAX_TOURS=4
# ODO_MAX_APPELS=8
# ODO_DELAI_OUTIL=10
# ODO_RESULTAT_MAX_CARACTERES=6000
# ODO_CONFIRMATION_TTL=300

# Gmail en lecture seule (docs/backend/GMAIL.md). Identifiants OAuth Google
# de type « Application Web » : SECRETS serveur, jamais dans Flutter.
# Absents : Gmail « non configuré ». Proposé seulement si ODO_ACTIF=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Identique à l'URI déclarée dans Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/integrations/gmail/retour
# GMAIL_MAX_RESULTATS=10
# GMAIL_CORPS_MAX_CARACTERES=4000
# GMAIL_FIL_MAX_MESSAGES=8

# --- LLM GroqCloud / OpenAI (fournisseur « groq » : tests et comparaisons) ----
# Option A : OpenAI (ex: sk-proj-...)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# Option B : Groq (gratuit et ultra-rapide, ex: gsk_...)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Longueur max d'une réponse, et nombre de messages d'historique envoyés au modèle.
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_HISTORY_MESSAGES=20
# Durée de vie du contexte court d'une conversation dans Redis, en secondes.
CHAT_CONTEXT_TTL=3600

# --- CORS (Flutter Web) -------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# --- Quotas -------------------------------------------------------------------
# Durée de cache des limites effectives (plan_config + abonnement), en secondes :
# délai maximal avant qu'une modification faite dans Supabase s'applique.
QUOTA_LIMITS_CACHE_TTL=30

# --- Horloge (surveillance, voir docs/backend/HORLOGE.md) ---------------------
# Les jetons Supabase sont refusés si l'horloge de la machine hôte dérive de
# plus de 10 s. Référence par défaut : {SUPABASE_URL}/auth/v1/health.
# CLOCK_REFERENCE_URL=
# Alerte (WARNING) au-delà de cet écart, en secondes.
CLOCK_SKEW_WARN_SECONDS=5
# Secondes entre deux mesures ; 0 = surveillance désactivée.
CLOCK_CHECK_INTERVAL=900
