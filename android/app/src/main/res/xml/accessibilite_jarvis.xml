<?xml version="1.0" encoding="utf-8"?>
<!-- JARVIS Touch : capture d'écran sur demande seulement. Aucun contenu de
     fenêtre lu, aucun geste, aucun événement utile (type minimal). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibilite_description"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:notificationTimeout="0"/>
