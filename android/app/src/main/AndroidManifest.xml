<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mode vocal : micro pour la reconnaissance vocale, Internet pour le
         service de reconnaissance du système quand il n'est pas hors ligne. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- JARVIS Touch : bulle au-dessus des autres applications, gardée par
         un service au premier plan (aucun micro). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- « Analyser l'écran » : capture ponctuelle (MediaProjection, une
         image, consentement Android à chaque fois). Aucun accès au stockage. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Vocal flottant : écoute hors de l'application, seulement pendant la
         session vocale ouverte par l'utilisateur (type déclaré à ce moment). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <application
        android:label="ia_jarvis"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Gmail : la page de retour de Google (serveur JARVIS) ramène
                 JARVIS au premier plan par jarvis://gmail. Aucun paramètre
                 n'est lu (jamais de jeton dans le lien) : l'application relit
                 l'état de la connexion auprès du serveur. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="jarvis" android:host="gmail"/>
            </intent-filter>
            <!-- Le lien ne doit pas devenir une navigation Flutter. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- Import WhatsApp : « Exporter la discussion » → JARVIS dans le
                 menu de partage. Export sans médias (TXT) ou archive (ZIP),
                 parfois mal étiquetée (octet-stream). singleTask : un partage
                 rejoint le JARVIS déjà ouvert (onNewIntent) au lieu d'en
                 ouvrir un second. Lecture par content:// seulement, avec le
                 droit temporaire accordé par WhatsApp : aucune permission de
                 stockage. -->
            <intent-filter android:label="JARVIS">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-zip"/>
                <data android:mimeType="application/x-zip-compressed"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Anciennes versions de WhatsApp : discussion (TXT) et médias
                 envoyés ensemble, types mélangés (« */* »). -->
            <intent-filter android:label="JARVIS">
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- JARVIS Touch : bulle flottante (type AssistiveTouch). -->
        <service
            android:name=".touch.ServiceJarvisTouch"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Bulle d’accès rapide à l'assistant, affichée au-dessus des autres applications à la demande de l'utilisateur."/>
        </service>
        <!-- « Analyser l'écran » : consentement Android à la capture.
             Transparente, sans animation, dans sa propre tâche et hors des
             récents : l'application consultée reste dessous (c'est elle
             qui est capturée), JARVIS n'est jamais ramené au premier plan. -->
        <activity
            android:name=".touch.capture.ActiviteCaptureEcran"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.example.ia_jarvis.capture"
            android:excludeFromRecents="true"
            android:theme="@style/CaptureTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"/>
        <!-- Capture ponctuelle : vit le temps d'une image, puis s'arrête. -->
        <service
            android:name=".touch.capture.ServiceCaptureEcran"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"/>
        <!-- « Analyser l'écran » sans autorisation à chaque capture : service
             d'accessibilité activé UNE fois par l'utilisateur (Android 11+,
             takeScreenshot). Il ne lit aucun contenu de fenêtre et ne traite
             aucun événement ; il ne prend une image que sur demande. -->
        <service
            android:name=".touch.capture.ServiceAccessibiliteJarvis"
            android:exported="false"
            android:label="@string/accessibilite_nom"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilite_jarvis"/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Import WhatsApp : bouton « Ouvrir WhatsApp » (visibilité des
             paquets, Android 11+). -->
        <package android:name="com.whatsapp"/>
        <package android:name="com.whatsapp.w4b"/>
        <!-- Mode vocal : service de reconnaissance vocale (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Mode vocal : moteur de synthèse vocale (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
